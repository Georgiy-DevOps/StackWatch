# Скопируйте в .env (он в .gitignore) и заполните. chmod 600 .env
# Домен должен указывать A/AAAA-записью на этот сервер — Caddy сам выпустит сертификат.
BESZEL_DOMAIN=monitor.example.com
ACME_EMAIL=admin@example.com

# Кто может открыть админку PocketBase (/_/). Через пробел. Лучше — IP VPN/WireGuard.
ADMIN_ALLOW_CIDRS=127.0.0.1/32

# Кто может открыть UI. По умолчанию — все; сузьте до своих сетей, если можно.
UI_ALLOW_CIDRS=0.0.0.0/0 ::/0

# Из окна «Добавить систему» в hub: публичный ключ и токен.
AGENT_KEY=ssh-ed25519 AAAA...
AGENT_TOKEN=change-me

# Опционально: интерфейсы для учёта трафика, например eth0
AGENT_NICS=
