# Default: accessible only from this computer.
HOST=127.0.0.1
PORT=4310
RETENTION_DAYS=7

# Required if HOST is not a loopback address. Use a random key of 16+ characters.
# HOST=0.0.0.0
# ACCESS_KEY=replace-with-a-long-random-access-key
# PUBLIC_ORIGIN=https://monitor.example.com
# Set only when the app is reachable exclusively through your own reverse proxy
# (e.g. Caddy from compose.production.yaml). Enables per-client login rate limiting
# via X-Forwarded-For. Never enable it when clients can reach the app directly.
# TRUST_PROXY=1

# Optional JSON webhook. No messages are sent unless you configure this.
# ALERT_WEBHOOK_URL=https://your-alert-handler.example.com/events
# ALERT_WEBHOOK_TOKEN=optional-bearer-token
# DATA_DIR=/var/lib/pulsewatch

# V2: automatic verified backups
BACKUP_HOURS=24
BACKUP_KEEP=7
# BACKUP_DIR=/mnt/private-backups/pulsewatch
# HEALTH_TOKEN=optional-random-24-plus-character-read-only-health-key
# Telegram defaults are imported only when a new database is created.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
