# Run on an independent machine. Both hosts should have synchronized clocks.
WATCHDOG_URL=https://monitor.example.com/healthz
# Get this read-only key in Settings -> External observer.
WATCHDOG_TOKEN=
WATCHDOG_TELEGRAM_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=
# Optional alternative or additional JSON webhook:
# WATCHDOG_WEBHOOK_URL=https://your-handler.example.com/events
# WATCHDOG_WEBHOOK_TOKEN=
# WATCHDOG_DATA_DIR=./watchdog-data
